# Copia este archivo a .env y complétalo localmente. El .env nunca se versiona (RNF-17).

# --- Base de datos ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketplace
SPRING_DATASOURCE_USERNAME=marketplace
SPRING_DATASOURCE_PASSWORD=cambiar
# Solo en la imagen Docker, si falta SPRING_DATASOURCE_URL (así los entrega Render).
DB_HOST=
DB_PORT=
DB_NAME=

# --- Pasarela de pagos (Stripe, modo prueba) ---
# "simulado" (por defecto) no sale a la red; "stripe" exige una clave sk_test_ y nunca hace pagos reales.
PAGOS_MODO=simulado
STRIPE_CLAVE_PRUEBA=sk_test_reemplazar
# Segundos que se espera a la pasarela antes de informar que no respondió.
PAGOS_TIEMPO_ESPERA_SEGUNDOS=10
# Conciliación de pagos en error: cada cuántos minutos corre y cuánta gracia da tras el apartado.
PAGOS_CONCILIACION_INTERVALO_MINUTOS=5
PAGOS_CONCILIACION_GRACIA_MINUTOS=60

# --- Aplicación ---
PUERTO=8080
# Commit que informa /api/estado; en Render se toma de RENDER_GIT_COMMIT.
VERSION_COMMIT=

# --- Autenticación (JWT) ---
# Secreto HS256 de al menos 32 bytes. Genéralo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=60

# --- Correo (código de recuperación de contraseña) ---
# "log" escribe el código en la consola (por defecto); "smtp" lo envía por correo.
# Con Gmail, MAIL_PASSWORD es una contraseña de aplicación (requiere verificación en 2 pasos).
CORREO_MODO=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
