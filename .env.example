# Copia este archivo a .env y complétalo localmente. El .env nunca se versiona (RNF-17).

# --- Base de datos ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketplace
SPRING_DATASOURCE_USERNAME=marketplace
SPRING_DATASOURCE_PASSWORD=cambiar

# --- Pasarela de pagos (Stripe, modo prueba) ---
STRIPE_CLAVE_PRUEBA=sk_test_reemplazar

# --- Aplicación ---
PUERTO=8080

# --- Autenticación (JWT) ---
# Secreto HS256 de al menos 32 bytes. Genéralo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=60

# --- Correo (código de recuperación de contraseña) ---
# "log" escribe el código en la consola (por defecto); "smtp" lo envía por correo.
# Con Gmail, MAIL_PASSWORD es una contraseña de aplicación (requiere verificación en 2 pasos).
CORREO_MODO=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
